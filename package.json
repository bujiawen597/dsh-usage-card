{
  "name": "dsh-usage-card",
  "version": "0.1.0",
  "description": "Sidebar usage card: DeepSeek account balance, this month's and today's token consumption",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bujiawen597/dsh-usage-card.git"
  },
  "homepage": "https://github.com/bujiawen597/dsh-usage-card#readme",
  "bugs": {
